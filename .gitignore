# PlatformIO: build output and downloaded libraries/toolchains (recreated by `pio run`)
.pio/

# VS Code files that PlatformIO generates per machine (recreate with `pio project init --ide vscode`)
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/

# FreeCAD backup files
*.FCBak
*.FCStd1
*.FCStd.bak

# Python
__pycache__/
*.pyc
.venv/

# Secrets: Wi-Fi passwords, API keys (future projects keep them in these files)
.env
secrets.h
credentials.h

# OS and editor junk
Thumbs.db
desktop.ini
.DS_Store
*.tmp
*.swp
*~
